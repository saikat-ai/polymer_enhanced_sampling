#MOLINFO STRUCTURE=npt.gro
WHOLEMOLECULES ENTITY0=1-242
c1: CENTER ATOMS=1-242

WATER_OXYGENS: GROUP ATOMS=243-66497:3

#COORD: COORDINATION GROUPA=MOL GROUPB=WATER_OXYGENS SWITCH={RATIONAL D_0=0.0 R_0=0.58 NN=50 MM=100} 
#COORD: COORDINATION GROUPA=WATER_OXYGENS GROUPB=MOL R_0=0.59
COORD: COORDINATION GROUPA=c1 GROUPB=WATER_OXYGENS SWITCH={RATIONAL D_0=0.0 R_0=0.60 NN=5 MM=12}

#compute distance between CA atoms of residues 1 and 40
r: GYRATION ATOMS=1-242

#compute distance between CA atoms of residues 1 and 40
d: DISTANCE ATOMS=2,239

# Apply different weights by scaling the collective variables
SCALED_COORD: MATHEVAL ARG=COORD FUNC=(x-5.5)/(40.0-5.5) PERIODIC=NO
SCALED_RG: MATHEVAL ARG=r FUNC=(x-0.6)/(2.35-0.60) PERIODIC=NO
SCALED_d: MATHEVAL ARG=d FUNC=(x-0.40)/(5.4-0.42)  PERIODIC=NO

COMBINE LABEL=lt0 ARG=SCALED_COORD,SCALED_RG,SCALED_d COEFFICIENTS=2.16,1.14,-0.28 PERIODIC=NO

#lt1_1: MATHEVAL ARG=lt1_1 FUNC=x- PERIODIC=NO
uwall: UPPER_WALLS ARG=lt0 AT=3.7 KAPPA=20000 EXP=4 EPS=1.0
lwall: LOWER_WALLS ARG=lt0 AT=-0.1 KAPPA=20000 EXP=4 EPS=1.0

# Metadynamics bias potential along the first TICA component
# Metadynamics bias potential using TICA and hydration shell count as collective variables
metad: METAD ARG=lt0 SIGMA=0.35, HEIGHT=1.5 PACE=400 BIASFACTOR=30.0 TEMP=300 GRID_MIN=-0.5, GRID_MAX=4.2

# Print out collective variables for monitoring
PRINT ARG=lt0,COORD,r,d,metad.* FILE=colvar1.dat STRIDE=1000

