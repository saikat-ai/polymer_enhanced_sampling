rg: READ FILE=colvar1.dat IGNORE_TIME VALUES=r
water: READ FILE=colvar1.dat IGNORE_TIME VALUES=COORD
metad: READ FILE=colvar1.dat IGNORE_TIME VALUES=metad.rbias
weights1: REWEIGHT_METAD TEMP=300 ARG=metad.rbias
#weights2: REWEIGHT_BIAS TEMP=300 ARG=uwall.bias

HISTOGRAM ...
ARG=rg,water
GRID_MIN=0.59,120
GRID_MAX=2.55,273
GRID_BIN=120,150
BANDWIDTH=0.016,0.30
LOGWEIGHTS=weights1
LABEL=hh1
... HISTOGRAM


DUMPGRID GRID=hh1 FILE=histo FMT=%24.16e
ff: CONVERT_TO_FES GRID=hh1 TEMP=300
#ff1:CONVERT_TO_FES GRID=hh2 TEMP=300
DUMPGRID GRID=ff FILE=fes2.dat

